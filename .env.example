# Copy to .env and enter your CurseForge upload API token.
CURSEFORGE_TOKEN=

# Exact game versions listed on CurseForge, comma-separated.
# Example for future supported versions: 1.60.1,1.60.2
# Separate from the addon release version.
CURSEFORGE_GAME_VERSION=1.60.1

CURSEFORGE_PROJECT_ID=334918

# Optional separate read API key for automatic release-version verification.
# See https://docs.curseforge.com/rest-api/ . Not needed for uploads.
CURSEFORGE_API_KEY=
